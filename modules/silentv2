local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Variables locales optimizadas
local Vector2_new = Vector2.new
local CFrame_new = CFrame.new
local WorldToViewportPoint = Camera.WorldToViewportPoint
local getrawmetatable = getrawmetatable or get_raw_metatable
local hookmetamethod = hookmetamethod or hook_meta_method
local getnamecallmethod = getnamecallmethod or get_name_call_method

-- Estado del objetivo actual
local CurrentTarget = nil

-- Asegurar que las configuraciones globales existan si el script se ejecuta solo
if not getgenv().IrvingSettings then
    getgenv().IrvingSettings = {
        AimEnabled = true,           
        FOV = 150,                
        MinFOV = 50,
        MaxFOV = 2000,
        ShowFOV = true,           
        TeamCheck = false,        
        Prediction = 0.165,
        TargetPart = "HumanoidRootPart",
        AbilityInfRange = true,   
        HighlightTargets = false, 
        FilterMode = "Blacklist (Ignore)",
        FilteredUsers = {},
        MaxAimRange = 4.999999721059845e+27,
    }
end
local Settings = getgenv().IrvingSettings

-- ConfiguraciÃ³n visual
local Highlight = Instance.new("Highlight")
Highlight.FillColor = Color3.fromRGB(245, 245, 250) 
Highlight.OutlineColor = Color3.fromRGB(245, 245, 250)
Highlight.FillTransparency = 0.5
Highlight.OutlineTransparency = 0
Highlight.Parent = game:GetService("CoreGui")

-- Funciones auxiliares
local function isPlayerFiltered(player)
    if Settings.FilterMode == "Blacklist (Ignore)" then
        return table.find(Settings.FilteredUsers, player.Name) ~= nil
    else
        return table.find(Settings.FilteredUsers, player.Name) == nil
    end
end

local function GetBestTarget()
    local bestTarget = nil
    local shortestDistance = Settings.FOV
    local mousePos = UserInputService:GetMouseLocation()
    local myChar = LocalPlayer.Character
    local myTeam = LocalPlayer.Team
    
    if not myChar then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            
            if Settings.TeamCheck and player.Team and myTeam then
                if player.Team == myTeam then continue end
            end
            
            if #Settings.FilteredUsers > 0 and isPlayerFiltered(player) then
                continue
            end

            local char = player.Character
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild(Settings.TargetPart)

            if hum and root and hum.Health > 0 then
                local actualDist = (root.Position - myChar:GetPivot().Position).Magnitude
                if actualDist > Settings.MaxAimRange then continue end

                local screenPos, onScreen = WorldToViewportPoint(Camera, root.Position)
                
                if onScreen then
                    local dist = (Vector2_new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    if dist < shortestDistance then
                        shortestDistance = dist
                        bestTarget = {
                            Player = player,
                            Character = char,
                            Root = root,
                            Position = root.Position,
                            Velocity = root.AssemblyLinearVelocity,
                            Distance = dist
                        }
                    end
                end
            end
        end
    end
    return bestTarget
end

-- Bucle principal del Aim
task.spawn(function()
    while true do
        if Settings.AimEnabled then
            CurrentTarget = GetBestTarget()
            
            if CurrentTarget then
                if Settings.HighlightTargets and CurrentTarget.Character then
                    Highlight.Adornee = CurrentTarget.Character
                else
                    Highlight.Adornee = nil
                end
            else
                Highlight.Adornee = nil
            end
        else
            CurrentTarget = nil
            Highlight.Adornee = nil
        end
        task.wait(0.05)
    end
end)

-- Hook a los mÃ©todos del juego para redirigir ataques y habilidades
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if not Settings.AimEnabled or not CurrentTarget then
        return oldNamecall(self, ...)
    end
    
    local method = getnamecallmethod()
    local args = {...}

    if Settings.AbilityInfRange and (method == "Raycast" or method == "raycast") then
        local origin = args[1]
        local targetPos = CurrentTarget.Root.Position + (CurrentTarget.Velocity * Settings.Prediction)
        args[2] = (targetPos - origin).Unit * 99999
        return oldNamecall(self, unpack(args))
    end

    if method == "FireServer" or method == "fireServer" or method == "InvokeServer" then
        local modified = false
        local predictedLocation = CurrentTarget.Root.Position + (CurrentTarget.Velocity * Settings.Prediction)

        for i, arg in pairs(args) do
            if typeof(arg) == "Vector3" then
                args[i] = predictedLocation
                modified = true
            elseif typeof(arg) == "CFrame" then
                if Settings.AbilityInfRange then
                    args[i] = CFrame_new(predictedLocation)
                else
                    args[i] = CFrame_new(LocalPlayer.Character.Head.Position, predictedLocation)
                end
                modified = true
            elseif type(arg) == "table" then
                for k, v in pairs(arg) do
                    if typeof(v) == "Vector3" then
                        arg[k] = predictedLocation
                        modified = true
                    elseif typeof(v) == "CFrame" then
                        if Settings.AbilityInfRange then
                            arg[k] = CFrame_new(predictedLocation)
                        else
                            arg[k] = CFrame_new(LocalPlayer.Character.Head.Position, predictedLocation)
                        end
                        modified = true
                    end
                end
            end
        end

        if modified then
            return oldNamecall(self, unpack(args))
        end
    end

    return oldNamecall(self, ...)
end)

