-- CONTROL + CLICK TP (STANDALONE)
-- MantÃ©n Left Control + Click Izquierdo para hacer TP
-- ==========================================
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local Mouse = LocalPlayer:GetMouse()
local ctrlPresionado = false

-- Detectar cuando se presiona la tecla Control
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftControl then 
        ctrlPresionado = true 
    end
end)

-- Detectar cuando se suelta la tecla Control
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftControl then 
        ctrlPresionado = false 
    end
end)

-- Detectar el click del ratÃ³n
Mouse.Button1Down:Connect(function()
    if ctrlPresionado then
        local personaje = LocalPlayer.Character
        if personaje and personaje:FindFirstChild("HumanoidRootPart") then
            local posicion = Mouse.Hit.Position
            -- Te teletransporta un poco mÃ¡s arriba (+3 en Y) para no quedarte atascado en el suelo
            personaje.HumanoidRootPart.CFrame = CFrame.new(posicion + Vector3.new(0, 3, 0))
        end
    end
end)
